{
  "name": "montclip-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "description": "MontClip desktop development shell",
  "scripts": {
    "start": "electron .",
    "fetch-ffmpeg": "node fetch-ffmpeg.cjs"
  },
  "devDependencies": {
    "electron": "45.2.1"
  },
  "build": {
    "appId": "dev.montclip.desktop",
    "productName": "MontClip",
    "extraResources": [
      {
        "from": "../vendor/ffmpeg/${platform}-${arch}",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe",
          "ffprobe",
          "ffprobe.exe",
          "LICENSE.txt",
          "SOURCE.json"
        ]
      }
    ]
  }
}
