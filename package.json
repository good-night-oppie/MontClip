{
  "name": "montclip",
  "version": "1.18.0",
  "private": true,
  "description": "MontClip: a zero-dependency browser video editor that AI agents can drive — JSON timeline, MCP server, REST API, live-reloading UI.",
  "main": "server/server.js",
  "bin": {
    "fablecut": "server/cli.js"
  },
  "files": [
    "*.js",
    "server/",
    "index.html",
    "style.css",
    "cindy-parts.css",
    "favicon.svg",
    "icons/",
    "encoding-profiles.json",
    "CLAUDE.md",
    "library/README.md",
    "library/elements/",
    "library/fonts/",
    "library/svg/",
    "library/sfx/README.md",
    "agent-ui/upstream/LICENSE",
    "agent-ui/upstream/NOTICE",
    "agent-ui/SOURCES.json",
    "agent-ui/THIRD-PARTY-NOTICES.txt",
    "LICENSES.md",
    "licenses/mediapipe/"
  ],
  "scripts": {
    "start": "node server/server.js",
    "test": "node --test",
    "test:integration": "node --test dev/real-tests/openrouter.integration.cjs",
    "test:e2e": "node dev/real-tests/run-deepseek-e2e.cjs",
    "test:e2e:meta": "node dev/real-tests/run-meta-e2e.cjs"
  },
  "keywords": [
    "video-editor",
    "nle",
    "timeline",
    "canvas",
    "mcp",
    "claude",
    "ai-agent",
    "ffmpeg"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/good-night-oppie/MontClip.git"
  },
  "homepage": "https://github.com/good-night-oppie/MontClip",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
