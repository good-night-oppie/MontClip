* text=auto eol=lf
# Licence texts are kept byte for byte: their SHA-256 is recorded in licenses/ffmpeg/inventory.json
licenses/ffmpeg/texts/** -text

# Preserve official upstream source bytes for provenance verification.
agent-ui/upstream/** -text
agent-ui/cindy-43001ea/** -text

# Vendored verbatim external source (Cindy, Apache-2.0, sources and hashes in agent-ui/SOURCES.json):
# folded as vendored, not generated — verbatim copies are not build output
agent-ui/upstream/** linguist-vendored
agent-ui/cindy-43001ea/** linguist-vendored

# True generated files: build outputs (build.cjs, styles.cjs, npm install) and machine-written records
# (vendor-cindy.cjs, licenses.cjs)
cindy-official.js linguist-generated
cindy-parts.css linguist-generated
package-lock.json linguist-generated
agent-ui/package-lock.json linguist-generated
agent-ui/cindy-strings.json linguist-generated
agent-ui/SOURCES.json linguist-generated
agent-ui/BUNDLED-LICENSES.json linguist-generated
agent-ui/THIRD-PARTY-NOTICES.txt linguist-generated
agent-ui/STYLE-PACKAGES.json linguist-generated
